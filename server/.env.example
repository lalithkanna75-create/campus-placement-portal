# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Neon / Supabase / Local)
# Direct connection string or pooled connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/placement_portal?schema=public"

# JWT Secret Keys
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
